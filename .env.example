# Clauset Gateway Configuration
PORT=3000

# Optional: URL of the wrapped Python Qdrant Edge engine (from edge-mem-main/mini-services/edge-engine)
# When unreachable or unset, Clauset runs its built-in Embedded TypeScript Mesh Runtime automatically.
PROTOCOL_ENGINE_URL=http://127.0.0.1:3030
PROTOCOL_ALLOWED_PORTS=3030,3031
# EDGE_TOKEN=

# Optional: OpenAI-compatible LLM for online synthesis (RAG Answer, Playbook Distillation, Auto-Classify)
# Restricted memories never leave the device and are automatically redacted before LLM calls.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
