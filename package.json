{
  "name": "clauset",
  "version": "1.3.0",
  "private": true,
  "description": "Clauset — Local-First Agent Memory & Policy Mesh",
  "scripts": {
    "dev": "node scripts/launch.mjs --dev",
    "next:dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "node scripts/launch.mjs --prod",
    "next:start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "cli": "node bin/clauset-cli.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
